#!/usr/bin/env python3
"""
bold2lox daemon – started as a service by systemd (postroot.sh). Every
poll_interval_seconds it:

1. runs the token keepalive: refreshes the Bold token once the last refresh is
   older than keepalive_hours, so the refresh token never sits unused and a
   revoked one shows up in auth.log within hours instead of at the door;
2. polls the Bold gateway status and pushes it via UDP to the Miniserver
   (optional feedback; skipped without a gateway id, so no API spam).
"""
import json
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import bold_engine  # noqa: E402


def main():
    bold_engine.CALLER = "daemon"
    while True:
        interval = 300
        try:
            cfg = bold_engine.load_settings()
            interval = int(cfg.get("poll_interval_seconds", 300))
            result = bold_engine.cmd_keepalive(cfg)
            if "skipped" not in result:
                print(f"[bold2lox] keepalive: {json.dumps(result)}", flush=True)
            bold_engine.cmd_status(cfg)
        except SystemExit as exc:
            print(f"[bold2lox] status error: {exc}", flush=True)
        except Exception as exc:  # noqa: BLE001
            print(f"[bold2lox] unexpected: {exc}", flush=True)
        time.sleep(max(30, interval))


if __name__ == "__main__":
    main()

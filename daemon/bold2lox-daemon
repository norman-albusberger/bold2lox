#!/usr/bin/env python3
"""
bold2lox Status-Daemon – pollt zyklisch den Bold-Gateway-Status und schiebt ihn
per UDP an den Miniserver (Virtual UDP Input). Von LoxBerry als Dienst gestartet.
Fuer die Rueckmeldung optional; die reine Steuerung braucht ihn nicht.
"""
import os
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", "bin"))
import bold_engine  # noqa: E402


def main():
    while True:
        cfg = bold_engine.load_config()
        try:
            bold_engine.cmd_status(cfg)
        except SystemExit as exc:
            print(f"[bold2lox] status-fehler: {exc}", flush=True)
        except Exception as exc:  # noqa: BLE001
            print(f"[bold2lox] unerwartet: {exc}", flush=True)
        time.sleep(int(cfg.get("poll_interval_seconds", 300)))


if __name__ == "__main__":
    main()
